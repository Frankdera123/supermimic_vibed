# caches and build output
.cache/
__pycache__/
*.pyc
build_*.log
# upstream checkout (pinned commit cloned by tools/setup.sh)
IsaacLab/
# third-party data (downloaded by tools/download_data.sh) and generated assets
data/
# training runs: checkpoints, logs
logs/
*.pt
# rendered videos and recorded trajectories (derived from CC BY-NC-ND LAFAN1 motions)
*.mp4
*.npz
results/analysis/
# third-party paper
*.pdf
# CRGF direction sets are small (1.6MB) and required to reproduce the
# exact perturbation protocols of the gradient-fidelity audits
!crgf_proto/results/crgf/*.pt
# PADA direction sets are small (~2MB) and required to reproduce the exact
# probe/eval perturbation protocols of PADA-0 (model snapshots stay ignored:
# 35MB each, regenerated by pada_proto/tools/pada_finetune_wm.py, SHA256 in
# results/pada/provenance.json)
!results/pada/dirs/*.pt
# CVF balanced-start + direction set is small (~0.5MB) and required to
# reproduce the CVF-0/CVF-1a perturbation protocols (oracle rollouts, raw
# collection batches and critic fine-tune checkpoints stay ignored: ~39MB,
# SHA256 recorded in results/cvf/sacv/manifests/*.json and
# results/cvf/sacv/experiment_registry.json)
!results/cvf/phase0/phase0_starts_and_dirs.pt
